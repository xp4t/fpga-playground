# Replace before installing as /etc/fpgapg/backend.env (root-owned, mode 0600).
BACKEND_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
ALLOWED_ORIGINS=https://fpgaplayground.com,https://www.fpgaplayground.com
PATH=/usr/local/bin:/usr/bin:/bin
OPENXC7_DIR=/srv/fpgapg-ws/.tools/openxc7
BUILD_QUEUE_DEPTH=4
BUILDS_PER_MINUTE=6
BUILD_TIMEOUT_SECONDS=2400
BUILD_MEMORY_MB=8192
BUILD_CPU_SECONDS=1800
BUILD_DISK_MB=512
BUILD_FILE_MB=128
