BACKEND_SECRET=replace-with-a-random-64-character-secret
ALLOWED_ORIGINS=https://your-frontend.vercel.app
BUILD_QUEUE_DEPTH=4
BUILDS_PER_MINUTE=6
BUILD_TIMEOUT_SECONDS=2400
BUILD_MEMORY_MB=4096
